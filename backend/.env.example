# Copy to the REPO ROOT as `.env` (read by both backend and frontend) and fill in.
# Never commit the real file.

# ---- Runtime ----
BACKEND_PORT=4000
BACKEND_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# DISABLE_RATE_LIMIT=true          # dev / e2e only

# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gymc
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/gymc_test

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_DEBUG_LOG=true

# ---- AI (OpenRouter) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_APP_URL=https://gymc.isiri.rw
OPENROUTER_APP_TITLE=Gisozi Youth Mass Choir Quiz

# ---- Embeddings (local) ----
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# EMBEDDINGS_FALLBACK=true

# ---- File storage ----
# Driver: "cloudinary" | "r2" | "local".  Auto-picks cloudinary then r2 when
# their credentials are present; "local" (filesystem) is the dev fallback.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=                 # optional; defaults to backend/.storage

# Cloudinary (recommended — reachable everywhere, free tier). All three required.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (S3 API) — alternative. Note: R2 is TLS-blocked from this
# project's production host, so this driver is not usable there today.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=gymc-materials
R2_PUBLIC_BASE_URL=

# ---- Email (Gmail SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gisozi Youth Mass Choir Quiz <no-reply@example.com>

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME=Gisozi Youth Mass Choir Quiz
