{
  "name": "gymc-quiz-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gisozi Youth Mass Choir Quiz — REST API for AI-powered choir quizzes and personalized learning feedback",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:status": "node src/db/migrate.js status",
    "db:reset": "node src/db/migrate.js reset",
    "seed": "node scripts/seed.js",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.665.0",
    "@aws-sdk/s3-request-presigner": "^3.665.0",
    "@xenova/transformers": "^2.17.2",
    "adm-zip": "^0.5.18",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.1",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.13.0",
    "globals": "^15.15.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.4"
  }
}
